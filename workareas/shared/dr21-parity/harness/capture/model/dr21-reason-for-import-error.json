      "name": "importReason",
      "legend": "What is the main reason for importing the animals?",
      "hint": null,
      "options": [
        {
          "value": "Internal market",
          "label": "Internal market",
          "hint": "For imports of animals intended for sale or use in Great Britain (England, Scotland or Wales).",
          "conditional": true
        },
        {
          "value": "Transhipment or onward travel",
          "label": "Transhipment or onward travel",
          "hint": "For animals intended for direct travel to a third country, that will stay only within the same port or airport in Great Britain while moving to another means of transport.",
          "conditional": true
        },
        {
          "value": "Transit",
          "label": "Transit",
          "hint": "For animals moving through Great Britain for direct travel to a third country, that will enter Great Britain at one port or airport and leave from a different one within England, Scotland or Wales.",
          "conditional": true
        },
        {
          "value": "Re-entry",
          "label": "Re-entry",
          "hint": "For animals authorised for re-entry, or rejected exports re-entering Great Britain.",
          "conditional": false
        },
        {
          "value": "Temporary admission horses",
          "label": "Temporary admission horses",
          "hint": "For horses authorised for temporary entry.",
          "conditional": true
        }
      ]
    },
    {
      "kind": "radios",
      "name": "internalMarketPurpose",
      "legend": "Purpose in the internal market",
      "hint": null,
      "options": [
        {
          "value": "Transfer of ownership - Sale/gift",
          "label": "Transfer of ownership - Sale/gift",
          "hint": "Any movement of an animal that has as its aim the sale of or the transfer of ownership of the animal from one person or entity to another. For example, animals that have been sold and are being moved to a new owner or will be sold once in Great Britain, purchases from a breeder/shop overseas and where an animal is being moved to a new owner with no sale involved (for example a gift).",
          "conditional": false
        },
        {
          "value": "Transfer of ownership - Rescue",
          "label": "Transfer of ownership - Rescue",
          "hint": "Ownership of animal/s changes from one person or entity to another through rehoming and is adopted/fostered by new families, with or without an exchange or donation of money.",
          "conditional": false
        },
        {
          "value": "Breeding",
          "label": "Breeding",
          "hint": "Animals for reproduction. This includes animals intended to contribute to the genetic pool of a breeding program, improve livestock quality, or produce offspring.",
          "conditional": false
        },
        {
          "value": "Research",
          "label": "Research",
          "hint": "Animals for use in scientific or medical research.",
          "conditional": false
        },
        {
          "value": "Racing, competition, show or training",
          "label": "Racing, competition, show or training",
          "hint": "Animals to participate in competitive or training events.",
          "conditional": false
        },
        {
          "value": "Approved premises or body",
          "label": "Approved premises or body",
          "hint": "Animals for exhibition, zoos, collections, or conservation programmes where a licence or approval is needed.",
          "conditional": false
        },
        {
          "value": "Companion animal not for resale or rehoming",
          "label": "Companion animal not for resale or rehoming",
          "hint": "Privately owned animals being imported under the commercial rules as the animal is unable to meet the non-commercial requirements, for example, one or more animals being transported by a commercial transporter without their owner or an authorised person, owner that is not traveling within five days of the animals' movement or a group of five or more animals being accompanied by their owner.",
          "conditional": false
        },
        {
          "value": "Production",
          "label": "Production",
          "hint": "Animals that are farmed for the production of meat, milk, eggs, wool or any other animal product or by-product.",
          "conditional": false
        },
        {
          "value": "Slaughter",
          "label": "Slaughter",
          "hint": "Animals to be slaughtered and processed for meat production shortly after arrival into Great Britain.",
          "conditional": false
        },
        {
          "value": "Fattening",
          "label": "Fattening",
          "hint": "Animals to be fattened for meat production.",
          "conditional": false
        },
        {
          "value": "Restocking",
          "label": "Restocking",
          "hint": "To replenish or enhance populations of species, for example, restocking of game or fish.",
          "conditional": false
        }
      ]
