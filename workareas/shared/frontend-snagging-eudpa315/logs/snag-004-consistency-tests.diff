+/**
+ * Gets a date-picker value relative to now, in the `dd/mm/yyyy` shape the
+ * arrival-date and date-of-issue inputs accept.
+ */
+export function getRelativeDatePickerValue(options: RelativeDateTimeOptions = {}): string {
+  const { day, month, year } = getRelativeDateInput(options);
+  return `${day}/${month}/${year}`;
+}
+
+/**
+ * Gets a date relative to now in the `d/m/yyyy` shape the app itself renders —
+ * no leading zeros, and month arithmetic clamped to the last day of the target
+ * month, matching the frontend's arrival-window calculation. Use this when
+ * asserting against app output such as the date picker's `data-min-date`.
+ */
+export function getRelativeAppDateText({ dayOffset = 0, monthOffset = 0 }: RelativeDateTimeOptions = {}): string {
+  const now = new Date();
+  const targetMonth = now.getMonth() + monthOffset;
+  // Day 0 of the following month is the last day of the target month.
+  const lastDayOfTargetMonth = new Date(now.getFullYear(), targetMonth + 1, 0).getDate();
+  const clamped = new Date(now.getFullYear(), targetMonth, Math.min(now.getDate(), lastDayOfTargetMonth));
+  clamped.setDate(clamped.getDate() + dayOffset);
+
+  return `${clamped.getDate()}/${clamped.getMonth() + 1}/${clamped.getFullYear()}`;
+}
+
 /**
  * Formats a Date for display using en-GB locale and optional format options.
